{
  "name": "dsh-repo-watch",
  "version": "0.2.0",
  "type": "module",
  "description": "DSH repository watchtower: it watches your GitHub repos in the background and only speaks up when someone is actually waiting on you.",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/Poy-Coder/dsh-repo-watch.git" },
  "homepage": "https://github.com/Poy-Coder/dsh-repo-watch#readme",
  "bugs": { "url": "https://github.com/Poy-Coder/dsh-repo-watch/issues" },
  "keywords": ["dsh", "deepseek-harness", "plugin", "github", "issues", "maintainer", "watch"],
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "lib/*.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "test/*.mjs",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": { "patch": "./cordis.patch.yml" }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "test": "node --test test/triage.test.mjs test/message.test.mjs"
  }
}
